647	            function playCurrentLine() {
648	                stopAudio();
649	
650	                const scene = lessonData.scenes[currentSceneIdx];
651	                const line = scene.lines[currentLineIdx];
652	                if (!line) return;
653	
654	                const fname = `audio/lesson01/scene${String(scene.id).padStart(2, "0")}_line${currentLineIdx.toString().padStart(2, "0")}.mp3`;
655	
656	                currentAudio = new Audio(fname);
657	                currentAudio.playbackRate = globalSpeed;
658	                currentAudio.onended = () => {
659	                    if (!isPlaying) return;
660	                    advanceToNext();
661	                };
662	
663	                currentAudio.play().catch((e) => {
664	                    console.warn("Audio play failed", e);
665	                    setTimeout(() => {
666	                        if (isPlaying) advanceToNext();
667	                    }, 1200);
668	                });
669	
670	                showScene(currentSceneIdx, currentLineIdx);
671	            }
