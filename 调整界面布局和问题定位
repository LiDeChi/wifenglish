554	            const zhKeyMap = {
555	                showroom: "展厅",
556	                welcome: "欢迎",
557	                "sofa set": "一套沙发",
558	                apartment: "公寓",
559	                "take your time": "慢慢看",
560	                catalogue: "目录",
561	                "three-seater": "三人沙发",
562	                fabric: "面料",
563	                "easy to clean": "好打理",
564	                "performance fabric": "功能面料",
565	                "stain-resistant": "防污",
566	                dimensions: "尺寸",
567	                centimeters: "厘米",
