518	
519	                        const en = highlightVocab(line.en, line.vocab || []);
520	                        const zh = highlightZhVocab(line.zh, line.vocab || []);
521	                        const avatarLabel = isSales ? "李" : "张";
522	                        const avatarBg = isSales ? "bg-amber-500" : "bg-slate-500";
