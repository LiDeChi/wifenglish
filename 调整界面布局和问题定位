673	            function advanceToNext() {
674	                let nextScene = currentSceneIdx;
675	                let nextLine = currentLineIdx + 1;
676	
677	                const currentSceneLines = lessonData.scenes[currentSceneIdx].lines.length;
678	
679	                if (nextLine >= currentSceneLines) {
680	                    nextScene = currentSceneIdx + 1;
681	                    nextLine = 0;
682	
683	                    if (nextScene >= lessonData.scenes.length) {
684	                        finishLesson();
685	                        return;
686	                    }
687	                }
688	
689	                showScene(nextScene, nextLine);
690	
691	                setTimeout(() => {
692	                    if (isPlaying) playCurrentLine();
693	                }, 420);
694	            }
